diff --git a/src/ControlStream.c b/src/ControlStream.c
index 2b5182e..1e42da0 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -2084,3 +2084,20 @@ bool LiGetHdrMetadata(PSS_HDR_METADATA metadata) {
     *metadata = hdrMetadata;
     return true;
 }
+
+// Artemis Switch: Apollo protocol extension - ask the host to run one of the
+// <ServerCommand> entries advertised in /serverinfo (index cmdId).
+int LiSendExecServerCmd(uint8_t cmdId) {
+    uint8_t payload[4] = {cmdId, 0, 0, 0};
+
+    if (!IS_SUNSHINE() || peer == NULL) {
+        return -2;
+    }
+
+    return sendMessageAndForget(0x3000,
+                                sizeof(payload),
+                                payload,
+                                CTRL_CHANNEL_SERVERCTL,
+                                ENET_PACKET_FLAG_RELIABLE,
+                                false) ? 0 : -1;
+}
